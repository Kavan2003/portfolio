// Cloudflare Workers config: serves the static Astro build in dist/ as assets.
// No Worker script; Cloudflare's build runs `npm run build`, then `npx wrangler deploy`.
{
	"name": "tkavan",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	}
}
