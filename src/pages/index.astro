---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portrait from '../assets/portrait.jpg';
import EntryList from '../components/EntryList.astro';
import SectionHead from '../components/SectionHead.astro';
import { getPublished } from '../lib/content';
import { SITE, UP_NEXT_TEARDOWNS } from '../site';

const teardowns = (await getPublished('teardowns')).slice(0, 5);
const notes = (await getPublished('notes')).slice(0, 5);
---

<Base>
	<section class="hero wrap">
		<p class="label kicker">
			{SITE.name} · {SITE.role} at <a href={SITE.company.url}>{SITE.company.name}</a>
		</p>
		<h1>{SITE.headline}</h1>
		<!-- Phase 2: the 3D avatar replaces this portrait (see PLANNING.md). -->
		<Image
			class="portrait"
			src={portrait}
			alt={SITE.name}
			widths={[240, 360, 480, 720]}
			sizes="(max-width: 40rem) 9rem, 20rem"
			loading="eager"
			fetchpriority="high"
		/>
		<div class="bio">
			<p>
				I'm Kavan, a {SITE.role} at {SITE.company.name}. Most of my work is spotting where people on our
				teams are doing the same thing over and over, then building what takes it off their plate: an AI
				agent that learns from our best CX agents, automations for payments, deliveries and repairs, and the
				dashboards that show whether any of it worked.
			</p>
			<p>
				I'm working my way toward product management, and I'm doing it in the open: teardowns of products I
				admire, and rough notes on what I'm learning along the way.
			</p>
		</div>
	</section>

	<section class="wrap block">
		<SectionHead
			title="Teardowns"
			note="How good products are built, and why."
			link={teardowns.length ? { href: '/teardowns', label: 'All teardowns' } : undefined}
		/>
		<EntryList entries={teardowns} base="/teardowns" upcoming={UP_NEXT_TEARDOWNS} />
	</section>

	<section class="wrap block">
		<SectionHead
			title="Notes"
			note="Rough, short, written to think."
			link={notes.length ? { href: '/notes', label: 'All notes' } : undefined}
		/>
		<EntryList
			entries={notes}
			base="/notes"
			digits={3}
			emptyText="The notebook is open. First entries land soon."
		/>
	</section>
</Base>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(14rem, 20rem);
		grid-template-areas:
			'kicker portrait'
			'title  portrait'
			'bio    bio';
		column-gap: var(--space-6);
		padding-top: clamp(var(--space-6), 10vw, var(--space-12));
	}

	.kicker {
		grid-area: kicker;
	}

	.portrait {
		grid-area: portrait;
		align-self: end;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 4px;
	}

	.kicker a {
		text-decoration: none;
		color: var(--ink);
	}

	.kicker a:hover {
		color: var(--accent);
	}

	h1 {
		grid-area: title;
		margin-top: var(--space-3);
		font-size: var(--text-display);
		font-weight: 400;
		line-height: 0.95;
		letter-spacing: -0.035em;
		max-width: 11ch;
	}

	.bio {
		grid-area: bio;
		margin-top: var(--space-6);
		margin-left: var(--margin-col);
		max-width: var(--measure);
		font-size: var(--text-lg);
		line-height: 1.5;
	}

	.bio p + p {
		margin-top: var(--space-2);
	}

	.block {
		margin-top: var(--space-12);
	}

	@media (max-width: 48rem) {
		.hero {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas:
				'kicker'
				'title'
				'portrait'
				'bio';
		}

		.portrait {
			width: 9rem;
			margin-top: var(--space-4);
		}
	}

	@media (max-width: 40rem) {
		.bio {
			margin-left: 0;
			font-size: var(--text-base);
		}
	}
</style>
