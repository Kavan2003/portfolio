---
import { SITE } from '../site';
---

<footer class="wrap">
	<p class="sign">Say hello: <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
	<ul>
		{
			SITE.links.map((link) => (
				<li>
					<a class="label" href={link.href} rel="me">
						{link.label}
					</a>
				</li>
			))
		}
		<li><a class="label" href="/rss.xml">RSS</a></li>
	</ul>
</footer>

<style>
	footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--space-2) var(--space-4);
		margin-top: var(--space-12);
		padding-block: var(--space-4) var(--space-6);
		border-top: 1px solid var(--rule);
	}

	.sign {
		font-size: var(--text-lg);
	}

	ul {
		display: flex;
		gap: var(--space-3);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	ul a {
		display: inline-block;
		padding-block: 0.6rem;
		text-decoration: none;
	}

	ul a:hover {
		color: var(--ink);
	}
</style>
