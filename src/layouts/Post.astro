---
import Base from './Base.astro';
import { formatDate, pad } from '../lib/content';

interface Props {
	kind: 'Teardown' | 'Note';
	number: number;
	digits: number;
	title: string;
	description?: string;
	date: Date;
	updated?: Date;
	back: { href: string; label: string };
}

const { kind, number, digits, title, description, date, updated, back } = Astro.props;
---

<Base title={title} description={description}>
	<article class="wrap">
		<header>
			<span class="num" aria-hidden="true">{pad(number, digits)}</span>
			<div>
				<p class="label">
					{`${kind} ${pad(number, digits)} · `}
					<time datetime={date.toISOString()}>{formatDate(date)}</time>
					{updated && <>{' · Updated '}<time datetime={updated.toISOString()}>{formatDate(updated)}</time></>}
				</p>
				<h1>{title}</h1>
				{description && <p class="dek">{description}</p>}
			</div>
		</header>
		<div class="prose">
			<slot />
		</div>
		<p class="back"><a class="label" href={back.href}>← {back.label}</a></p>
	</article>
</Base>

<style>
	header {
		display: grid;
		grid-template-columns: var(--margin-col) minmax(0, 1fr);
		align-items: start;
		padding-block: clamp(var(--space-6), 8vw, var(--space-12)) var(--space-6);
	}

	.num {
		font-family: var(--font-mono);
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		font-weight: 300;
		line-height: 1;
		letter-spacing: -0.04em;
		color: var(--accent);
	}

	h1 {
		margin-top: var(--space-2);
		font-size: clamp(2.25rem, 5.5vw, 4rem);
		font-weight: 400;
		line-height: 1.05;
		letter-spacing: -0.03em;
		max-width: 20ch;
	}

	.dek {
		margin-top: var(--space-3);
		max-width: var(--measure);
		font-size: var(--text-lg);
		line-height: 1.45;
		color: var(--ink-muted);
	}

	.prose,
	.back {
		margin-left: var(--margin-col);
	}

	.back {
		margin-top: var(--space-8);
	}

	.back a {
		text-decoration: none;
	}

	@media (max-width: 40rem) {
		header {
			grid-template-columns: 1fr;
		}

		.prose,
		.back {
			margin-left: 0;
		}
	}
</style>
